# Copy to .streamlit/secrets.toml (never commit the real file).
# On Streamlit Cloud paste the same content in  App -> Settings -> Secrets.
# On Docker/Render/Railway you can use environment variables with the same names instead.

# --- Email reminders (any SMTP provider; Gmail needs an "App password") ---
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"                       # 587 = STARTTLS, 465 = SSL
SMTP_USER = "you@gmail.com"
SMTP_PASSWORD = "your-app-password"
SMTP_FROM = "TaskFlow <you@gmail.com>"  # optional

# ALLOW_SIGNUP = "false"                # close registration on a private server

# --- Optional: "Continue with Google" (name + profile picture) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web).
# Authorised redirect URI:  https://YOUR-APP-URL/oauth2callback
# [auth]
# redirect_uri = "https://YOUR-APP-URL/oauth2callback"
# cookie_secret = "a-long-random-string"
# [auth.google]
# client_id = "xxxx.apps.googleusercontent.com"
# client_secret = "xxxx"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
